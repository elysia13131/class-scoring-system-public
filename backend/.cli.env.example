# 远程数据管理 CLI 配置示例
# 复制为 .cli.env 并填写实际值

# 后端基础地址
# 本地开发: http://127.0.0.1:3001
# 远程生产: https://your-domain.cpolar.top  (cpolar 暴露的地址)
CLI_API_BASE=http://127.0.0.1:3001

# 鉴权密钥 (与后端环境变量 CLI_API_KEY 保持一致)
# 后端启动时若未设置 CLI_API_KEY，则使用 INTERNAL_API_KEY（每次重启变化）
# 生产部署建议在 docker run / docker-compose 中固定设置:
#   docker run -e CLI_API_KEY=your-secret-key-here ...
CLI_API_KEY=please-change-me-to-a-long-random-string
